#include <Windows.h>

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "GridLock.manifest"

1000 YAMLDATA "GridLockConfig.default.yaml"
1001 HTMLDATA "GridLockDocumentation.html"

#if (1 == RELEASE_VERSION)
1002 ICON     "GridLock.ico"
1003 ICON     "GridLockError.ico"
1004 ICON     "GridLockWarning.ico"
1005 ICON     "GridLockInfo.ico"
#else
1002 ICON     "GridLockPlaceholder.ico"
1003 ICON     "GridLockPlaceholderError.ico"
1004 ICON     "GridLockPlaceholderWarning.ico"
1005 ICON     "GridLockPlaceholderInfo.ico"
#endif
